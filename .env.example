# Host de la base de datos
DB_HOST=
# Contraseña de la base de datos
DB_PASSWORD=
# Usuario de la base de datos
DB_USER=
# Puerto para conectarse a la base de datos
DB_PORT=
# Nombre de la base de datos
DB_NAME=
# URL de Redis para la conexión
REDIS_URL=
# Entorno actual del proyecto (development, production, etc.)
ENVIRONMENT=
# Firma secreta para usar en el ACCESS TOKEN puedes usar una pagina como https://www.vondy.com/random-key-generator--ZzGGMYgS?lc=5
ACCESS_TOKEN_SECRET_KEY=
# Firma secreta para usar en el REFRESH TOKEN puedes usar una pagina como https://www.vondy.com/random-key-generator--ZzGGMYgS?lc=5
REFRESH_TOKEN_SECRET_KEY=
# Algoritmo que va a usar jwt para hashear
ALGORITHM=
# Tiempo para el refresh token expire en DÍAS
REFRESH_TOKEN_EXPIRE=
# Tiempo para que el jwt expire en MINUTOS
ACCESS_TOKEN_EXPIRE=
# Hostname del servidor SMTP (ej: smtp.gmail.com, smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com).
MAIL_SERVER=
# Puerto SMTP. 587 = STARTTLS (recomendado, moderno). 465 = SSL/TLS implícito. 25 = plaintext
MAIL_PORT=
# Abre la conexión en plano y la upgradea a TLS con el comando STARTTLS. Recomendado con puerto 587.
# Mutuamente excluyente con MAIL_SSL_TLS. Si ambos estan en false la conexión quedaría sin cifrar.
MAIL_STARTTLS=
# Envuelve toda la sesión SMTP en TLS desde el primer byte como HTTPS. Usar SOLO con puerto 465.
# Mutuamente excluyente con MAIL_STARTTLS. Si ambos en True, el comportamiento depende de la libreria.
MAIL_SSL_TLS=
# Cuenta que envía los correos
MAIL_USERNAME=
# Contraseña del correo eléctronico
MAIL_PASSWORD=
# Dirección que aparece en el header "From:" del correo.
MAIL_FROM=
# API KEY del modelo de IA
AI_API_KEY=
# Url para usar el modelo
AI_BASE_URL=
# Modelo que se va a usar para el chatbot
AI_MODEL=
# Máxima cantidad de tokens o limite de longitud de la respuesta del modelo
AI_MAX_TOKENS=
# Nivel de creatividad del modelo, recomendado 0.3 para evitar alucinaciones
AI_TEMPERATURE=
# Boleano para decidir si esta activo o no el chat
CHATBOT_ENABLED=
# Host de qdrant
QDRANT_HOST=
# Puerto que usa qdrant
QDRANT_PORT=
# Modelo usado para crear lo embeddings de la información
EMBEDDING_MODEL=
# Token de hugging face
HF_TOKEN=
# Google OAuth Client Id
GOOGLE_CLIENT_ID=
# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=
# URL a la que se redigira el usuario ej: "http://localhost:5173"
GOOGLE_REDIRECT_URL=